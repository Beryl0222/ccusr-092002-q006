{
  "service": "icu-family-evidence",
  "description": "照护假制度契约：按生效日版本化；跨版本区间按本地日拆分，各日适用当期制度。额度按本地日历日计，金额按实际申报且凭证覆盖的分钟计。",
  "timezone_offset_minutes": 480,
  "leave_kinds": {
    "icu_care_leave": "重症照护假（须现场；ICU窗口或紧急文书事件支持）",
    "family_care_leave": "家庭照护假（转院/出院/手续办理）",
    "standby_duty": "院方待命（不计缺勤）",
    "remote_work": "远程办公（远程办理手续/转院协调）",
    "annual_leave": "年假（与照护时段重叠时优先按年假，不另增照护假）",
    "personal_affairs": "事假（无凭证或额度用尽时的兜底）"
  },
  "rule_fields": {
    "max_calendar_days": "每个制度版本下该假别的本地日历日额度上限；缺省表示不限",
    "pay_rate": "付薪比例，0~1",
    "daily_hours_cap": "单本地日计薪小时上限，跨午夜按日分别封顶",
    "eligible_events": "可支持该假别的凭证事件类型；* 表示任意",
    "remote_eligible": "是否接受远程在场方式",
    "remote_required": "是否必须为远程在场方式"
  },
  "versions": [
    {
